  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "backfill:claims": "node --env-file=.env.local scripts/backfill-claims.mjs",
    "link:supplies": "node --env-file=.env.local scripts/link-template-supplies.mjs",
    "verify:delivery-math": "node scripts/verify-delivery-math.mjs",
    "audit:branding": "node scripts/audit-branding.mjs",
    "seed:demo": "node --env-file=.env.local scripts/seed-demo.mjs",
    "check:env": "node --env-file=.env.local scripts/check-env.mjs",
    "fix:env": "node scripts/fix-env.mjs",
    "audit:writes": "node scripts/audit-client-writes.mjs",
    "add:index": "node scripts/add-index.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "exceljs": "^4.4.0",
    "firebase": "^12.15.0",
