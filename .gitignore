# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Claude Code local session settings (permission allowlists, etc.)
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# Local scratch space — walkthrough harnesses, never committed
.scratch/

# Generated by npm run seed:demo — holds a demo account password
demo-customer.txt
# Generated by npm run seed:staff — holds the seeded staff passwords
demo-staff.txt
.tmp-verify/

# Per-app Next build output (the monorepo has one per workspace).
apps/*/.next/
apps/*/tsconfig.tsbuildinfo

# Per-app Next output for the flat layout.
web/.next/
admin/.next/
pos/.next/
*/tsconfig.tsbuildinfo

# Built deployables — scripts/package-app.mjs
/dist/

# Scratch patch scripts — written, run, deleted. Never committed.
.patch.mjs

# Local data copies from scripts/backup.mjs — never committed.
backups/

# The Windows counter app (desktop/) is its own package, outside the
# workspaces: its Electron download must never reach a Hostinger build.
desktop/node_modules/
desktop/dist/
# The POS server copied in for hub mode — scripts/package-hub.mjs.
desktop/hub-bundle/

# A café hub's local database on a developer's machine — npm run hub:seed.
.hub/
