# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Claude Code local session settings (permission allowlists, etc.)
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# Local scratch space — walkthrough harnesses, never committed
.scratch/

# Generated by npm run seed:demo — holds a demo account password
demo-customer.txt
.tmp-verify/

# Per-app Next build output (the monorepo has one per workspace).
apps/*/.next/
apps/*/tsconfig.tsbuildinfo

# Per-app Next output for the flat layout.
web/.next/
admin/.next/
pos/.next/
*/tsconfig.tsbuildinfo
