{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/pricelist/layout,_N_T_/pricelist/page,_N_T_/pricelist"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/pricelist/__PAGE__",
    "/pricelist",
    "/_index",
    "/_head"
  ]
}