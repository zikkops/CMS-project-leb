      "namedRegex": "^/api/wholesale/orders(?:/)?$"
    },
    {
      "page": "/customer/friends",
      "regex": "^/customer/friends(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/customer/friends(?:/)?$"
    },
    {
      "page": "/customer/login",
      "regex": "^/customer/login(?:/)?$",
