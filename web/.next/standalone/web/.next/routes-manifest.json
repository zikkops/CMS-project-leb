    {
      "page": "/wholesale",
      "regex": "^/wholesale(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/wholesale(?:/)?$"
    },
    {
      "page": "/wholesale/login",
      "regex": "^/wholesale/login(?:/)?$",
